# ==========================================
# Backend Production Environment Variables
# ==========================================

# Telegram API Credentials
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your_telegram_api_hash_here

# Security Secrets
SECRET_KEY=change_this_to_a_secure_jwt_secret_key_32_bytes_min
ENCRYPTION_SECRET=u6LhG5p-aBf7YQ2n_X9sV8kZ1mP3wE5rT7yU0iO4pK8=

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:your_password@your-db-host.com:5432/telegram_exporter

# Or individual DB fields:
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=telegram_exporter

# CORS Settings (Comma-separated origins for production frontend)
ALLOWED_ORIGINS=https://app.yourdomain.com,https://yourdomain.com
