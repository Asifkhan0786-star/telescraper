# ==========================================
# Telegram Member Exporter - Environment Configuration
# ==========================================

# 1. Telegram API Credentials (Get from https://my.telegram.org)
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your_telegram_api_hash_here

# 2. Security & Encryption Keys
# Generate SECRET_KEY with: openssl rand -hex 32
SECRET_KEY=change_this_to_a_secure_jwt_secret_key_32_bytes_min
# Generate ENCRYPTION_SECRET with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_SECRET=u6LhG5p-aBf7YQ2n_X9sV8kZ1mP3wE5rT7yU0iO4pK8=

# 3. PostgreSQL Database Connection
# Full connection string for Managed PostgreSQL (Supabase, Render Postgres, AWS RDS, Neon)
DATABASE_URL=postgresql+asyncpg://postgres:your_secure_password@your-db-host.com:5432/telegram_exporter

# Or individual parameters if DATABASE_URL is not set:
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=telegram_exporter

# 4. CORS Production Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=https://app.yourdomain.com,https://yourdomain.com

# 5. Frontend Public API URL (Used during Next.js build time)
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
